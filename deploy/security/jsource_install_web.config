<?xml version="1.0" encoding="UTF-8"?>
<!--
  배치 위치: D:\Jboard\Jsource\install\web.config (새로 추가)
  테이블/DB 생성 스크립트 폴더를 웹에서 아예 열 수 없게 통째로 차단.
  (근본적으로는 Jsource\install 폴더 자체를 서버에서 삭제/이동하는 걸 권장 — cleanup_readme.txt 참고)
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="false" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
