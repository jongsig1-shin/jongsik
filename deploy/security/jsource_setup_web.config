<?xml version="1.0" encoding="UTF-8"?>
<!--
  배치 위치: D:\Jboard\Jsource\setup\web.config (새로 추가)
  DB 설치 마법사(setup1.asp 등)를 웹에서 아예 열 수 없게 폴더 전체를 차단.
  설치가 끝난 뒤에는 필요 없는 폴더라, 정리 전까지 임시로 이 web.config로 막아둠.
  (근본적으로는 Jsource\setup 폴더 자체를 서버에서 삭제/이동하는 걸 권장 — cleanup_readme.txt 참고)
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="false" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
