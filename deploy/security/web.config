<?xml version="1.0" encoding="UTF-8"?>
<!--
  배치 위치: D:\Jboard\web.config (기존 파일을 이걸로 덮어쓰기)
  기존 설정(대용량 업로드 허용, 상세 오류는 로컬에서만)은 그대로 유지하고,
  "정상적인 웹사이트 운영에서는 절대 다운로드될 일이 없는" 확장자만 사이트 전체에서 차단.
  allowUnlisted="true"라서 asp/css/js/이미지 등 원래 쓰던 파일들은 전혀 영향 없음.

  주의: .zip/.exe/.sql처럼 "자료실" 게시판 등에서 방문자에게 실제로 내려주고 있을 수도
  있는 확장자는 일부러 여기서 빼뒀습니다 (사이트 전체 차단하면 그 다운로드 기능이 막힘).
  DB 백업(.bak, data 폴더 안)과 설치 스크립트는 이 파일이 아니라 폴더별 web.config
  (data_folder_web.config 등)로 별도 차단하므로, 이 확장자들을 굳이 여기서 막을 필요는 없음.
  자료실에서 .zip/.exe를 안 쓰신다면 알려주세요 — 추가로 막아드리겠습니다.
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="4294967295" />
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".ex-" allowed="false" />
                    <add fileExtension=".mdf" allowed="false" />
                    <add fileExtension=".ldf" allowed="false" />
                    <add fileExtension=".config" allowed="false" />
                    <add fileExtension=".old" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
        <httpErrors errorMode="DetailedLocalOnly" />

        <!-- 2026-09-02 추가 — CSS/JS/이미지 같은 정적 파일을 브라우저가 너무 오래(또는
             영구적으로) 캐시해서, 파일을 고쳐 올려도 방문자 화면에 반영이 안 되는 문제가
             반복적으로 있었음(캐시 방지용 버전 번호를 붙여도 안 되는 경우까지 있었음).
             지금처럼 사이트를 한창 수정하는 동안은 정적 파일 캐시를 아예 꺼서, 파일을
             올리면 항상 최신 내용이 바로 보이도록 함. asp로 만들어지는 페이지 자체에는
             영향 없음(정적 파일에만 적용됨). 나중에 사이트가 안정되면 이 부분은 지워서
             다시 정상적으로 캐시하게 해도 됨(그래야 방문자 데이터 사용량에 유리함). -->
        <staticContent>
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>
    </system.webServer>
</configuration>
