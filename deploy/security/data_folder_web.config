<?xml version="1.0" encoding="UTF-8"?>
<!--
  배치 위치: D:\Jboard\data\web.config (이 폴더에는 원래 web.config가 없었으므로 새로 추가)
  data 폴더 전체(그 안의 temp\Jboard_....bak DB 백업 포함)를 웹에서 아예 접근 못하게 통째로 차단.
  allowUnlisted="false" + 허용 목록을 비워둬서 확장자 불문 전부 막음.
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="false" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
